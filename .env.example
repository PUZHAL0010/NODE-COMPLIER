# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_USER_MAX_CONCURRENT=2
RATE_LIMIT_PROJECT_MAX_CONCURRENT=1

# Worker & Queue Configuration
WORKER_CONCURRENCY=8
MAX_SANDBOXES_PER_HOST=8
QUEUE_NAME=node-execution

# Sandbox Runtime
# Options: 'docker' (default in production) or 'process' (fallback / CI / test mode)
SANDBOX_RUNTIME=docker
DOCKER_IMAGE=node-sandbox-runner:20-alpine
SANDBOX_WORKSPACE_DIR=/tmp/node-compiler-sandboxes

# Resource & Execution Limits
DEFAULT_TIMEOUT_MS=5000
MAX_TIMEOUT_MS=5000
DEFAULT_MEMORY_MB=512
MAX_MEMORY_MB=512
DEFAULT_CPUS=1.0
MAX_CPUS=1.0
MAX_PIDS=32
MAX_FILES=100
MAX_FILE_SIZE_BYTES=1048576
MAX_PROJECT_SIZE_BYTES=5242880
MAX_STDOUT_BYTES=1048576
MAX_STDERR_BYTES=1048576
