      "type": "timeseries",
      "targets": [
        {
          "expr": "max(ide_execution_duration_p50_ms)",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "max(ide_execution_duration_p95_ms)",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "max(ide_execution_duration_p99_ms)",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineInterpolation": "smooth"
          }
        }
