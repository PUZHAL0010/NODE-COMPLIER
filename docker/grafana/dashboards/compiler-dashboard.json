        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Queue Backpressure (Waiting Jobs)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ide_queue_waiting_jobs)",
          "legendFormat": "Waiting in Queue",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
