      "type": "stat",
      "targets": [
        {
          "expr": "sum(ide_executions_total)",
          "legendFormat": "Total Jobs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" }
